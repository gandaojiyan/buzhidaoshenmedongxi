&amp;1&#10;                                                                      sleep 30                                                                                                                                    PID=$(adb shell pidof com.bbk.updater | tr -d &apos;\r&apos;)                   echo "PID=$PID"&#10;                                                                      # 运行状态&#10;adb shell dumpsys activity activities &gt; updater_system30_activity.txt adb shell dumpsys window windows &gt; updater_system30_window.txt        &#10;# UI                                                                  adb shell uiautomator dump /sdcard/updater_system30_ui.xml &gt;/dev/null 2&gt;&amp;1&#10;adb shell cat /sdcard/updater_system30_ui.xml &gt; updater_system30_ui.xml                                                                                                                                           # 日志                                                                adb logcat -d &gt; updater_system30_main.log                             adb logcat -b system -d &gt; updater_system30_system.log&#10;adb logcat -b events -d &gt; updater_system30_events.log                 adb logcat -b crash -d &gt; updater_system30_crash.log&#10;                                                                      # 进程状态 / 线程&#10;if [ -n "$PID" ]; then                                                    adb shell "cat /proc/$PID/status" &gt; updater_system30_status.txt       adb shell "ls -l /proc/$PID/fd" &gt; updater_system30_fd.txt&#10;    adb shell "cat /proc/$PID/maps" &gt; updater_system30_maps_all.txt       adb shell "cat /proc/$PID/task/$PID/status" &gt; updater_system30_task_status.txt                                                          else                                                                      : &gt; updater_system30_status.txt                                       : &gt; updater_system30_fd.txt                                           : &gt; updater_system30_maps_all.txt&#10;    : &gt; updater_system30_task_status.txt                              fi&#10;                                                                      # FOTA / 安全 / 网络关键字&#10;grep -iE \                                                            &apos;bbk.updater|UpdateTempActivity|UpdateActivity|UpdatePresenter|CheckUpdate|CheckResult|BaseCheckUpdateTask|HttpUtils|SecurityUtils|SecurityKey|SDKCipher|VgcSdk|VgcSdkManager|vivoseckey|jvq_param|getVgcAndPatch|downloadURL|sysupgrade|vgc/v2|FOTA|okhttp|https?://|URLConnection|TLS&apos; \                                                                    updater_system30_main.log \&#10;updater_system30_system.log \                                         updater_system30_events.log \&#10;updater_system30_crash.log \                                          &gt; updater_system30_filtered.log || true&#10;                                                                      # 单独看看 vivoseckey 是否加载                                        grep -iE &apos;vivoseckey|seckey|lib.*crypto|ssl|conscrypt&apos; \&#10;updater_system30_maps_all.txt \                                       &gt; updater_system30_security_maps.txt || true&#10;                                                                      # 提取 updater 自己的 dumpsys 关键段&#10;grep -nE \                                                            &apos;com.bbk.updater|mResumedActivity|mLastPausedActivity|finishing=|mVisible=|state=|UpdateTempActivity|UpdateActivity&apos; \                      updater_system30_activity.txt \                                       &gt; updater_system30_activity_filtered.txt || true&#10;                                                                      git add updater_system30_*                                            git commit -m "capture Updater system entry thirty second probe"      git push origin main                                                  PID=25038&#10;                                         