psys connectivity | grep -Ei \&#10;      &apos;NetworkAgentInfo|VPN|WIFI|MOBILE|VALIDATED|CONNECTED&apos; || true  &#10;    echo&#10;    echo "===== DNS ====="&#10;    adb shell getprop | grep -Ei \&#10;      &apos;dns|proxy&apos; || true&#10;&#10;    echo&#10;    echo "===== sysupgrade DNS ====="&#10;    adb shell getent hosts sysupgrade.vivo.com.cn 2&gt;/dev/null || true&#10;} &gt; updater_network_state.txt&#10;&#10;echo&#10;echo "===== 10. 关键结果 ====="&#10;&#10;echo&#10;echo "--- PID ---"&#10;cat updater_pid.txt&#10;&#10;echo&#10;echo "--- filtered logs ---"&#10;cat updater_all_log_filtered.txt&#10;&#10;echo&#10;echo "--- current activity ---"&#10;grep -Ei \&#10;  &apos;mResumedActivity|mFocusedApp|com\.bbk\.updater|UpdateActivity&apos; \&#10;  updater_activity_top.txt | head -50 || true&#10;&#10;echo&#10;echo "--- UI XML ---"&#10;grep -oE \&#10;  &apos;text="[^"]*"|content-desc="[^"]*"|resource-id="[^"]*"&apos; \&#10;  updater_ui.xml \&#10;  | head -200 || true&#10;&#10;echo&#10;echo "--- network ---"&#10;cat updater_network_state.txt&#10;&#10;echo&#10;echo "===== 11. Git ====="&#10;git add \&#10;  updater_logcat_all_buffers.txt \&#10;  updater_activity_top.txt \&#10;  updater_window.txt \&#10;  updater_ui.xml \&#10;  updater_all_log_filtered.txt \&#10;  updater_pid.txt \&#10;  updater_network_state.txt&#10;&#10;git commit -m "capture all Updater logs UI and network state"&#10;git push&#10;===== 1. 清空全部 Android 日志 =====&#10;===== 2. 启动 UpdateActivity =====&#10;Starting: Intent { act=com.bbk.updater.action.START_UPDATERACTIVITY cmp=com.bbk.updater/.ui.UpdateActivity }&#10;&#10;===== 3. 等待 15 秒 =====&#10;===== 4. 抓取所有 logcat buffer =====&#10;===== 5. 抓取当前 Activity / Window =====&#10;===== 6. 导出当前 UI 层级 =====&#10;' checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="true" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[10,66][710,1466]" /></node><node index="2" text="ZeroTermux&#10;双击命令窗口打开